root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[Jenkinsfile]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[tests/fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset
end_of_line = unset
